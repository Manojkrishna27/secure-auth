# -----------------------------------
# Database
# -----------------------------------
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_strong_password_here
DB_NAME=secure_auth

# -----------------------------------
# Flask / Security
# -----------------------------------
FLASK_ENV=production
JWT_SECRET=your_64_byte_random_secret_here

# -----------------------------------
# CORS — comma-separated allowed frontend origins
# -----------------------------------
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# -----------------------------------
# Email / SMTP
# -----------------------------------
ADMIN_EMAIL=your_admin_email@gmail.com
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password
SECURITY_ALERT_EMAIL=your_admin_email@gmail.com

# -----------------------------------
# Rate Limiter (optional — defaults to memory://)
# Use redis://redis:6379 for multi-worker production
# -----------------------------------
# RATE_LIMIT_STORAGE=memory://

# -----------------------------------
# Logging (optional — defaults to INFO)
# -----------------------------------
# LOG_LEVEL=INFO